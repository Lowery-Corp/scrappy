DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/postgres
REDIS_URL=redis://db-cache:6379/0

AUTH_API_URL=http://auth-service:8000
OFFLOAD_API_URL=http://offload-service:8000

MINIO_API_URL=minio:9000
MINIO_ROOT_USER=replace-me
MINIO_ROOT_PASSWORD=replace-me
MINIO_SECURE=false

INTERNAL_API_USERNAME=replace-me
INTERNAL_API_PASSWORD=replace-me
CELERY_BROKER_URL=redis://db-cache:6379/1
CELERY_RESULT_BACKEND=redis://db-cache:6379/2
RABBITMQ_DEFAULT_USER=replace-me
RABBITMQ_DEFAULT_PASS=replace-me

COOKIE_KEY=scrappy_access_token
COOKIE_SECURE=false
SCRAPPYS_API_KEY=replace-me
ALLOWED_ORIGINS=["http://localhost:5175"]
MAX_UPLOAD_SIZE_BYTES=52428800

OPENAI_API_KEY=replace-me
OPENAI_API_URL=https://api.openai.com
OPENAI_DEFAULT_MODEL=replace-me
COOKIE_SECURE=false
